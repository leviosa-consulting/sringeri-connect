# Copy to .env and fill in. .env is git-ignored; this template is committed.
# On Replit these are injected as real environment variables and no .env exists.
#
# Quote every value in single quotes. Two of them require it:
#   - PAYTM_MERCHANT_KEY contains '#', which parsers otherwise treat as a comment.
#   - FIREBASE_SERVICE_ACCOUNT_JSON must be single-quoted on ONE line, with the
#     escaped newlines in private_key left as literal backslash-n.

# --- Local server port -----------------------------------------------------
# Optional. Defaults to 5000. Set this if something else on your machine
# already uses that port. Replit sets its own PORT via .replit.
PORT=''

# --- Database -------------------------------------------------------------
# Local restored copy ONLY. Boot-time DDL and `npm run db:push` both execute
# against whatever this names, so it must never point at production.
# The project uses a dedicated trust-auth cluster on port 5544 (no password) -
# see "The local database" in CLAUDE.md.
DATABASE_URL='postgresql://postgres@localhost:5544/sringeri_local'

# Production Neon, used only by pg_dump. No application code reads this.
PROD_DATABASE_URL=''

# --- Session --------------------------------------------------------------
SESSION_SECRET=''

# --- Sringeri DSSP API ----------------------------------------------------
SRINGERI_API_KEY=''

# --- Paytm ----------------------------------------------------------------
PAYTM_MID=''
PAYTM_MERCHANT_KEY=''
PAYTM_MID_SPCT=''
PAYTM_MERCHANT_KEY_SPCT=''

# --- Google Translate -----------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=''

# --- Gmail (nodemailer) ---------------------------------------------------
GMAIL_USER=''
GMAIL_APP_PASSWORD=''

# --- Firebase Admin (server) ----------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=''

# --- Client (exposed in the browser bundle - non-secret only) -------------
# On Replit these come from .replit [userenv.shared].
VITE_FIREBASE_API_KEY=''
VITE_FIREBASE_AUTH_DOMAIN=''
VITE_FIREBASE_PROJECT_ID=''
VITE_SRINGERI_API_URL='https://dsspv2.lcpl.in'
ANALYTICS_ADMIN_UIDS=''
VITE_ANALYTICS_ADMIN_UIDS=''
